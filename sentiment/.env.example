# Alpaca keys for the SECOND paper account (not the day trader's)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Filled in by scripts/setup.sh: the day trader's account number ("none" if there is none).
# Before the monorepo these were PAPER_TRADER_ACCOUNT and PAPER_TRADER_STATE, which still work.
DAYTRADER_ACCOUNT=
# Optional: the day trader's data folder, read-only, for compare.py (default: ../daytrader/data)
DAYTRADER_STATE=
# Optional: ntfy.sh topic for alerts
NTFY_TOPIC=
# Optional: where scripts/backup.sh copies the newest archive
BACKUP_DIR=
# Broker backends (see README "Broker backends"). Defaults shown.
# BROKER_BACKEND=alpaca     # where orders go: alpaca (paper only) or ibkr (stub)
# DATA_BACKEND=alpaca       # where bars, the calendar and news come from
# ALLOW_LIVE=               # set to 1 only to let a backend trade a LIVE account
# IBKR_HOST=127.0.0.1
# IBKR_PORT=4002            # IB Gateway paper; 4001 is live
# IBKR_CLIENT_ID=18
# IBKR_ACCOUNT=             # DU... for paper
